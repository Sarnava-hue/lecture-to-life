DATABASE_URL=postgresql+psycopg2://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/lecture_to_life

SECRET_KEY=replace_this_with_a_long_random_secret_key

ACCESS_TOKEN_EXPIRE_MINUTES=60

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_REQUESTS=30
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

UPLOAD_DIR=storage/lectures
MAX_UPLOAD_SIZE_MB=100
